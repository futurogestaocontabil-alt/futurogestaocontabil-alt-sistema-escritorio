{
  "name": "plataforma-futuro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,APP \"tsx watch server/index.ts\" \"vite --host 127.0.0.1 --port 4317 --strictPort\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
